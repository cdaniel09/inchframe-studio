# Copy this file to .env.local for local development.
# Generate ADMIN_PASSWORD_HASH with: npm run hash-password -- "your password"
AUTH_SECRET=replace-with-a-long-random-string
ACCOUNT_SSO_BASE_URL=https://account.inchframe.com
STUDIO_AUTH_MODE=hybrid
STUDIO_SSO_CLIENT_ID=studio
STUDIO_SSO_CLIENT_SECRET=replace-with-the-same-secret-configured-on-account
STUDIO_SSO_REDIRECT_URI=http://localhost:3000/api/auth/account/callback
ADMIN_EMAIL=info@inchframe.com
VERIFIED_EMAIL_ALLOWLIST=admin@inchframe.com
INQUIRY_NOTIFICATION_EMAIL=info@inchframe.com
ADMIN_PASSWORD_HASH=scrypt$replace-with-generated-value
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=info@inchframe.com
SMTP_PASS=replace-with-info-mailbox-password
EMAIL_FROM=Inchframe Studio <info@inchframe.com>
EMAIL_REPLY_TO=info@inchframe.com
# For local-only testing without sending mail:
# EMAIL_TRANSPORT=console
DATABASE_PATH=./data/inchframe-studio.sqlite
UPLOAD_DIR=./data/uploads
NEXT_PUBLIC_SITE_URL=http://localhost:3000
STUDIO_MIN_PROJECT_CENTS=30000
STUDIO_REVIEW_THRESHOLD_CENTS=1000000
STUDIO_PLATFORM_FEE_BPS=2000
STUDIO_LAUNCH_STATUS=coming_soon
STUDIO_PARTNER_APPLICATIONS_OPEN=false
STRIPE_SECRET_KEY=sk_test_replace
STRIPE_WEBHOOK_SECRET=whsec_replace
