# Copy this file to .env.local for local development.
# Generate ADMIN_PASSWORD_HASH with: npm run hash-password -- "your password"
AUTH_SECRET=replace-with-a-long-random-string
ADMIN_EMAIL=info@inchframe.com
ADMIN_PASSWORD_HASH=scrypt$replace-with-generated-value
CLIENT_SIGNUP_CODE=replace-with-a-private-client-access-code
DATABASE_PATH=./data/inchframe-studio.sqlite
UPLOAD_DIR=./data/uploads
NEXT_PUBLIC_SITE_URL=http://localhost:3000
