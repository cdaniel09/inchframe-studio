# Copy this file to .env.local for local development.
# Generate ADMIN_PASSWORD_HASH with: npm run hash-password -- "your password"
AUTH_SECRET=replace-with-a-long-random-string
ADMIN_EMAIL=info@inchframe.com
VERIFIED_EMAIL_ALLOWLIST=admin@inchframe.com
INQUIRY_NOTIFICATION_EMAIL=info@inchframe.com
CREATOR_INVITE_SECRET=replace-with-a-shared-random-secret
ADMIN_PASSWORD_HASH=scrypt$replace-with-generated-value
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=info@inchframe.com
SMTP_PASS=replace-with-info-mailbox-password
EMAIL_FROM=Inchframe Studio <info@inchframe.com>
EMAIL_REPLY_TO=info@inchframe.com
# For local-only testing without sending mail:
# EMAIL_TRANSPORT=console
DATABASE_PATH=./data/inchframe-studio.sqlite
UPLOAD_DIR=./data/uploads
NEXT_PUBLIC_SITE_URL=http://localhost:3000
